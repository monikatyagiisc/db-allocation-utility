# PostgreSQL (used by backend)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=nagarro
DB_NAME=db_allocation

# App ports
API_PORT=8080
FRONTEND_PORT=3000

SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging (LOG_LEVEL: DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
LOG_FILE=.local/logs/api.log
LOG_REQUEST_BODY=true

# Email — Microsoft Outlook / Office 365 (SMTP)
# Use an app password if your account has MFA: https://account.microsoft.com/security
EMAIL_ENABLED=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=you@yourcompany.com
SMTP_PASSWORD=your-outlook-app-password
MAIL_FROM=you@yourcompany.com
