# PostgreSQL (used by backend)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=nagarro
DB_NAME=db_allocation

# App ports
API_PORT=8080
FRONTEND_PORT=3000

SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging (LOG_LEVEL: DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
LOG_FILE=.local/logs/api.log
LOG_REQUEST_BODY=true

# Email — Microsoft Outlook / Office 365
EMAIL_ENABLED=false
MAIL_FROM=you@yourcompany.com

# Provider: graph (recommended) | smtp
# Most corporate tenants disable SMTP basic auth (error 5.7.139) — use graph.
EMAIL_PROVIDER=graph

# --- Microsoft Graph (OAuth2 app registration) ---
# Azure Portal → App registrations → New → API permissions → Application → Mail.Send → Grant admin consent
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
GRAPH_SEND_AS=you@yourcompany.com

# --- SMTP (only if your tenant still allows basic auth) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=you@yourcompany.com
SMTP_PASSWORD=your-app-password

# JIRA Cloud — add comments to issues (API token from https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_ENABLED=false
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=your-jira-api-token
